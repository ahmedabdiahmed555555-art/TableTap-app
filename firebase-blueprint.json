{
  "entities": {
    "MenuItem": {
      "title": "Menu Item",
      "description": "Represents a food or drink item on the restaurant menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Breakfast", "Lunch", "Dinner", "Drinks"] },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a customer's order for a specific table.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tableNumber": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "status": { "type": "string", "enum": ["pending", "preparing", "served"] },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tableNumber", "items", "status", "total", "createdAt"]
    }
  },
  "firestore": {
    "menuItems": {
      "schema": "MenuItem",
      "description": "Collection of all available menu items."
    },
    "orders": {
      "schema": "Order",
      "description": "Collection of all customer orders."
    }
  }
}
